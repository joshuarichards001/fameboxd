---
import { SUGGEST_FORM_URL } from "../data/site";

interface Props {
	headline?: string;
	intro?: string;
}

const {
	headline = "Famous",
	intro = "A directory of notable people with real, public Letterboxd accounts. See what each of them watched most recently.",
} = Astro.props;
---

<header
	class="header-glow border-b border-border py-[clamp(1.5rem,4vw,2.4rem)]"
>
	<div class="wrap">
		<a
			class="mb-1.5 inline-block text-[0.78rem] font-bold uppercase tracking-[0.14em] text-text-faint no-underline transition-colors duration-[120ms] hover:text-orange focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue motion-reduce:transition-none"
			href="/">Fameboxd</a
		>
		<h1
			class="m-0 text-[clamp(1.7rem,4.5vw,2.5rem)] font-extrabold leading-[1.05] tracking-[-0.02em]"
		>
			<span id="headline">{headline}</span>{" "}<span class="text-orange"
				>on Letterboxd</span
			>
		</h1>
		<p
			class="mt-2 mb-0 max-w-[56ch] text-[clamp(0.95rem,2vw,1.05rem)] text-text-dim"
		>
			{intro}
		</p>
		<a
			class="mt-4 inline-block rounded-full border border-border bg-bg-raised px-4 py-1.5 text-[0.85rem] font-semibold text-orange transition-colors duration-[120ms] hover:bg-bg-raised-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue motion-reduce:transition-none"
			href={SUGGEST_FORM_URL}
			target="_blank"
			rel="noopener"
		>
			Suggest a person &rarr;
		</a>
	</div>
</header>
