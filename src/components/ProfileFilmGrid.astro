---
import { posterUrl } from "../functions/activity";
import { filmPageUrl, filmTitle, hasFilmPage } from "../functions/films";
import type { ProfileFilm } from "../functions/profiles";

interface Props {
	items: ProfileFilm[];
	eagerCount?: number;
}

const { items, eagerCount = 0 } = Astro.props;

const rewatchText = (film: ProfileFilm) =>
	film.rewatchCountKnown
		? `Watched ${film.entries.toLocaleString("en")} times`
		: "Marked as a rewatch";

const accessibleFacts = (film: ProfileFilm) => {
	const facts: string[] = [];
	if (film.representativeRating != null) {
		facts.push(`rated ${film.representativeRating} out of 5`);
	}
	if (film.liked) facts.push("liked");
	if (film.rewatched) facts.push(rewatchText(film).toLowerCase());
	return facts.join(", ");
};
---

<ul class="grid grid-cols-3 gap-x-2 gap-y-5 sm:grid-cols-6 sm:gap-x-4 sm:gap-y-6">
	{
		items.map((film, index) => {
			const linked = hasFilmPage(film.slug);
			const Card = linked ? "a" : "div";
			return (
				<li class="min-w-0">
					<Card
						class:list={[
							"group block min-w-0 text-text no-underline",
							linked &&
								"focus-visible:rounded-card focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-blue",
						]}
						href={linked ? filmPageUrl(film.slug) : undefined}
						aria-label={linked ? `${filmTitle(film)}: ${accessibleFacts(film)}` : undefined}
					>
						<span class="block aspect-[2/3] overflow-hidden rounded-card border border-border bg-bg-raised">
							{film.poster ? (
								<img
									class="block h-full w-full object-cover transition-transform duration-[160ms] group-hover:scale-[1.03] motion-reduce:transition-none"
									src={posterUrl(film.poster, 300)}
									srcset={`${posterUrl(film.poster, 300)} 300w, ${posterUrl(film.poster, 600)} 600w`}
									sizes="(min-width: 640px) 150px, 31vw"
									width="300"
									height="450"
									loading={index < eagerCount ? "eager" : "lazy"}
									decoding="async"
									alt={filmTitle(film)}
								/>
							) : (
								<span class="flex h-full items-center justify-center p-2 text-center text-[0.7rem] font-bold text-text-faint sm:text-[0.8rem]">
									{film.title}
								</span>
							)}
						</span>
						<span class:list={["mt-2 block truncate text-[0.78rem] font-semibold", linked ? "text-orange underline decoration-orange/50 underline-offset-2 group-hover:decoration-current" : "text-text"]}>
							{film.title}
						</span>
						<span class="mt-1 flex min-h-5 flex-wrap items-center gap-1 text-[0.68rem] leading-tight text-text-faint">
							{film.representativeRating != null && (
								<span class="font-bold text-green tabular-nums" aria-label={`Rated ${film.representativeRating} out of 5`}>
									{film.representativeRating.toFixed(1)}★
								</span>
							)}
							{film.liked && (
								<span class="font-bold text-orange"><span aria-hidden="true">♥</span><span class="sr-only">Liked</span></span>
							)}
							{film.rewatched && (
								<span><span aria-hidden="true">↻</span> {film.rewatchCountKnown ? `${film.entries}×` : "Rewatch"}</span>
							)}
						</span>
					</Card>
				</li>
			);
		})
	}
</ul>
