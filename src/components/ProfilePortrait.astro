---
interface Props {
    name: string;
    username: string;
}

const { name, username } = Astro.props;
const src = `/avatars/${username}.webp`;
---

<button
    id="portrait-open"
    type="button"
    class="h-[72px] w-[72px] shrink-0 cursor-zoom-in rounded-full focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue"
    aria-label={`Enlarge profile picture of ${name}`}
    aria-haspopup="dialog"
    aria-controls="portrait-dialog"
>
    <img
        class="h-full w-full rounded-full border border-border bg-bg object-cover"
        src={src}
        width="72"
        height="72"
        alt=""
    />
</button>

<dialog
    id="portrait-dialog"
    aria-label={`Profile picture of ${name}`}
    class="m-auto overflow-auto rounded-card border border-border bg-bg-raised p-0 text-text shadow-2xl backdrop:bg-black/80"
>
    <div>
        <div class="flex items-center justify-between gap-3 px-4 py-2">
            <span class="font-semibold">{name}</span>
            <form method="dialog" class="shrink-0">
                <button
                    type="submit"
                    class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-full text-2xl text-text-dim hover:bg-bg-raised-hover hover:text-text focus-visible:outline-2 focus-visible:outline-blue"
                    aria-label="Close profile picture"
                    autofocus
                >
                    <span aria-hidden="true">&times;</span>
                </button>
            </form>
        </div>
        <img class="block h-auto w-full" src={src} alt={name} />
    </div>
</dialog>

<style>
    dialog {
        width: min(24rem, calc(100vw - 2rem), calc(100dvh - 6rem));
        max-height: calc(100dvh - 2rem);
    }

    :global(html:has(#portrait-dialog[open])) {
        overflow: hidden;
    }
</style>

<script>
    const trigger = document.querySelector<HTMLButtonElement>("#portrait-open");
    const dialog = document.querySelector<HTMLDialogElement>("#portrait-dialog");

    if (trigger && dialog) {
        trigger.addEventListener("click", () => dialog.showModal());
        dialog.addEventListener("click", (event) => {
            if (event.target === dialog) dialog.close();
        });
    }
</script>
