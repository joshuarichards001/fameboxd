---
import { tagLabel, tagPageTitle, tagSlug } from "../functions/tags";

interface Props {
	allTags: string[];
	counts: Map<string, number>;
	total: number;
	shown: number;
	activeTag: string | null;
}

const { allTags, counts, total, shown, activeTag } = Astro.props;

const SORTS = [
	{ key: "recent", label: "Recently active" },
	{ key: "az", label: "A–Z" },
	{ key: "followers", label: "Followers" },
];
---

<section
	class="sticky top-0 z-[5] mb-2 border-b border-border bg-bg/90 pt-4 pb-3 backdrop-blur-[8px] max-[520px]:static"
	aria-label="Filter and sort"
>
	<div>
		<div class="mb-[0.4rem] flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
			<span
				class="text-[0.78rem] font-semibold uppercase tracking-[0.06em] text-text-faint"
				id="tag-filter-label">Filter by tag</span
			>
			<p
				class="m-0 text-[0.85rem] text-text-dim [&_strong]:text-text"
				id="count"
				aria-live="polite"
			>
				Showing <strong>{shown}</strong> of <strong>{total}</strong> people
			</p>
		</div>
		<div
			class="flex flex-wrap gap-1.5"
			role="group"
			aria-labelledby="tag-filter-label"
		>
			{
				allTags.map((tag) => {
					const active = tag === activeTag;
					return (
						<a
							class="pill cursor-pointer rounded-full border border-border bg-bg-raised px-3 py-1 text-[0.8rem] font-semibold text-text-dim no-underline transition-colors duration-[120ms] hover:bg-bg-raised-hover hover:text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue aria-pressed:border-green aria-pressed:bg-green aria-pressed:text-[#0c1418] motion-reduce:transition-none"
							href={active ? "/" : `/${tagSlug(tag)}/`}
							role="button"
							data-tag={tag}
							data-path={`/${tagSlug(tag)}/`}
							data-label={tagLabel(tag)}
							data-title={tagPageTitle(tag, counts.get(tag) ?? 0)}
							aria-pressed={active ? "true" : "false"}
						>
							{tagLabel(tag)}
						</a>
					);
				})
			}
			<a
				class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-dashed border-border bg-transparent px-3 py-1 text-[0.8rem] font-semibold text-text-faint no-underline transition-colors duration-[120ms] hover:border-orange hover:text-orange focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue motion-reduce:transition-none"
				href="/"
				role="button"
				id="clear-pill"
				title="Show everyone"
				hidden={activeTag == null}
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					width="12"
					height="12"
					fill="none"
					stroke="currentColor"
					stroke-width="3"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<line x1="5" y1="5" x2="19" y2="19"></line>
					<line x1="19" y1="5" x2="5" y2="19"></line>
				</svg>
				Clear
			</a>
		</div>
	</div>

	<div class="mt-3">
		<span
			class="mb-[0.4rem] block text-[0.78rem] font-semibold uppercase tracking-[0.06em] text-text-faint"
			id="sort-label">Sort by</span
		>
		<div class="flex flex-wrap items-center gap-1.5">
			<div
				class="flex flex-wrap gap-1.5"
				role="group"
				aria-labelledby="sort-label"
			>
				{
					SORTS.map((s) => (
						<button
							type="button"
							class="sort-pill cursor-pointer rounded-full border border-border bg-bg-raised px-3 py-1 text-[0.8rem] font-semibold text-text-dim transition-colors duration-[120ms] hover:bg-bg-raised-hover hover:text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue aria-pressed:border-blue aria-pressed:bg-blue aria-pressed:text-[#0c1418] motion-reduce:transition-none"
							data-sort={s.key}
							aria-pressed={s.key === "recent" ? "true" : "false"}
						>
							{s.label}
						</button>
					))
				}
			</div>
			<div
				id="search-wrap"
				class="group relative flex h-8 w-8 shrink-0 items-center transition-[width] duration-200 data-[open]:w-40 max-[520px]:data-[open]:w-32 motion-reduce:transition-none"
			>
				<input
					type="search"
					id="search-input"
					placeholder="Search people…"
					aria-label="Search people"
					class="pointer-events-none absolute inset-0 h-8 w-full rounded-full border border-border bg-bg-raised py-1 pr-9 pl-3 text-[0.85rem] text-text opacity-0 outline-none transition-opacity duration-200 placeholder:text-text-faint focus:border-blue group-data-[open]:pointer-events-auto group-data-[open]:opacity-100 motion-reduce:transition-none"
				/>
				<button
					type="button"
					id="search-toggle"
					aria-label="Search people"
					aria-expanded="false"
					aria-controls="search-input"
					class="relative ml-auto flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-full border border-border bg-bg-raised text-text-dim transition-colors duration-[120ms] hover:bg-bg-raised-hover hover:text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						width="15"
						height="15"
						fill="none"
						stroke="currentColor"
						stroke-width="2.25"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<circle cx="11" cy="11" r="7" />
						<line x1="21" y1="21" x2="16.65" y2="16.65" />
					</svg>
				</button>
			</div>
		</div>
	</div>
</section>
