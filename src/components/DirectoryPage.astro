---
import activity from "../data/activity.json";
import people from "../data/people.json";
import { loadAvatarSet } from "../functions/avatars";
import { sortByRecentActivity, sortPeople, tagCounts, tagsByFrequency } from "../functions/people";
import { tagIntro, tagLabel, tagPageTitle } from "../functions/tags";
import { validateActivity, validatePeople } from "../functions/validate";
import Base from "../layouts/Base.astro";
import Directory from "./Directory.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import SearchControls from "./SearchControls.astro";

interface Props {
	activeTag?: string | null;
}

const { activeTag = null } = Astro.props;

validatePeople(people);
validateActivity(activity, people);

const sorted = sortPeople(people);
const allTags = tagsByFrequency(sorted);
const counts = tagCounts(sorted);
const total = sorted.length;
// Tag pages only render their own people; the client-side filter (homepage
// only) needs the full set.
const visible = activeTag
	? sorted.filter((p) => p.tags.includes(activeTag))
	: sorted;
const shown = visible.length;
const avatarSet = loadAvatarSet();

const label = activeTag ? tagLabel(activeTag) : null;
// Counts lead the title as a click-through hook. The homepage no longer names
// actors/directors — that was competing with the tag pages for their queries.
const title = activeTag
	? tagPageTitle(activeTag, shown)
	: `${total} Celebrities on Letterboxd | Fameboxd`;
// Tag pages show the same line in the header and as the meta description.
const intro = activeTag ? tagIntro(activeTag, shown) : undefined;
const description =
	intro ??
	`A directory of ${total} celebrities with verified Letterboxd accounts, from Martin Scorsese to Charli XCX. Updated daily.`;
---

<Base title={title} description={description}>
	<Header headline={label ?? "Celebrities"} intro={intro} />

	<main class="wrap">
		<SearchControls
			allTags={allTags}
			counts={counts}
			total={total}
			shown={shown}
			activeTag={activeTag}
		/>
		<Directory
			people={sortByRecentActivity(visible)}
			avatarSet={avatarSet}
			activeTag={activeTag}
		/>
	</main>

	<Footer />
</Base>
