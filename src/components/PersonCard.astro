---
import {
	activity,
	entriesFor,
	filmNoun,
	personPageUrl,
} from "../functions/activity";
import { hueFor, initials } from "../functions/avatars";
import {
	compactCount,
	profileUrl,
	stars,
	timeAgo,
	type Person,
} from "../functions/people";

interface Props {
	person: Person;
	hasAvatar: boolean;
	// The first row of cards is above the fold, so lazy-loading their avatars
	// only delays them until after layout. Directory sets this on that row.
	eager?: boolean;
}

const { person: p, hasAvatar, eager = false } = Astro.props;
const lastWatched = p.lastWatched ?? null;
const followers = p.followers ?? null;
const entries = entriesFor(activity, p.username);
const diaryLabel = `${entries.length} ${filmNoun(entries.length)}`;
---

<li
	class="card"
	data-name={p.name.toLowerCase()}
	data-tags={p.tags.join(" ")}
	data-followers={p.followers ?? 0}
	data-films={entries.length}
>
	{/* The card lifts on hover, except while the Letterboxd link below is hovered:
	    it goes somewhere other than the internal person page the card itself
	    opens, so the card shouldn't claim the cursor. .card-out marks it for
	    that :has() check, not a style hook. */}
	<div
		class="group relative flex w-full flex-col rounded-card border border-border bg-bg-raised px-4 pt-[0.9rem] pb-[0.85rem] transition-[border-color,background] duration-[140ms] not-has-[.card-out:hover]:hover:border-[color-mix(in_srgb,var(--color-orange)_45%,var(--color-border))] not-has-[.card-out:hover]:hover:bg-bg-raised-hover motion-reduce:transition-none"
	>
		<div class="flex items-center gap-[0.7rem]">
			{
				hasAvatar ? (
					<img
						class="h-[42px] w-[42px] shrink-0 rounded-full border border-border bg-bg object-cover"
						src={`/avatars/${p.username}.webp`}
						width="42"
						height="42"
						loading={eager ? "eager" : "lazy"}
						fetchpriority={eager ? "high" : undefined}
						decoding="async"
						alt=""
					/>
				) : (
					<span
						class="flex h-[42px] w-[42px] shrink-0 items-center justify-center rounded-full border text-[0.9rem] font-bold tracking-[0.02em] text-[hsl(var(--hue)_55%_80%)] bg-[hsl(var(--hue)_32%_24%)] border-[hsl(var(--hue)_28%_34%)]"
						aria-hidden="true"
						style={`--hue:${hueFor(p.name)}`}
					>
						{initials(p.name)}
					</span>
				)
			}
			<h2
				class="m-0 min-w-0 flex-1 text-[1.05rem] font-bold leading-snug tracking-[-0.01em]"
			>
				{/* Stretched link: its ::after covers the card, so a click anywhere
				    lands on this person's internal page. The Letterboxd link at the
				    bottom sits above that overlay as the card's external exit. */}
				<a
					class="rounded-[3px] no-underline after:absolute after:inset-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
					href={personPageUrl(p.username)}
					aria-label={`${p.name} on Fameboxd`}
				>
					{p.name}
				</a>
			</h2>
			{
				followers != null && (
					<span
						class="flex shrink-0 items-center gap-1 self-start text-[0.75rem] font-semibold text-text-faint tabular-nums"
						title={`${followers.toLocaleString("en")} followers on Letterboxd`}
					>
						{/* One <symbol> in Directory.astro, instanced here: inlining
						    this icon 180 times cost 70 KB of HTML and ~720 DOM
						    nodes, which is most of its parse cost. */}
						<svg width="11" height="11" aria-hidden="true">
							<use href="#i-followers" />
						</svg>
						{compactCount(followers)}
					</span>
				)
			}
		</div>
		<ul class="mt-2 flex flex-wrap gap-[0.35rem]" aria-label="Tags">
			{
				p.tags.map((t) => (
					<li class="rounded-full border border-blue/30 bg-blue/[0.14] px-2 py-[0.1rem] text-[0.68rem] font-bold uppercase tracking-[0.04em] text-blue">
						{t}
					</li>
				))
			}
		</ul>
		<p class="mt-2 mb-3 flex-1 text-[0.875rem] leading-[1.5] text-text-dim">
			{p.description}
		</p>
		<span class="mt-auto flex flex-col gap-1 border-t border-border pt-2.5">
			{
				lastWatched && (
					<span class="flex items-baseline gap-x-1.5 text-[0.8rem] leading-snug">
							<span class="shrink-0 text-text-faint">Watched</span>
							<span class="min-w-0 truncate font-semibold text-text-dim">
								{lastWatched.title}
							</span>
							{lastWatched.rating != null && (
								<span
									class="shrink-0 text-green"
									role="img"
									aria-label={`rated ${lastWatched.rating} out of 5`}
								>
									{stars(lastWatched.rating)}
								</span>
							)}
							{lastWatched.date && (
								<span class="shrink-0 text-[0.75rem] text-text-faint">
									{timeAgo(lastWatched.date)}
								</span>
							)}
					</span>
				)
			}
			{/* The film count describes the internal page without adding a second
			    link to it. The Letterboxd handle is the card's external exit and
			    sits above the stretched link's overlay:
			    z-1 clears that overlay and stays under the sticky filter bar's
			    z-5, which it would otherwise scroll over. */}
			<span class="mt-1 flex items-center justify-between gap-2">
				<span
					class="min-w-0 truncate text-[0.78rem] font-semibold text-text-faint tabular-nums"
				>
					{diaryLabel}
				</span>
				<a
					class="card-out relative z-1 flex min-w-0 items-center gap-1 rounded-[3px] text-[0.78rem] font-semibold text-orange no-underline hover:text-[color-mix(in_srgb,var(--color-orange)_80%,white)] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
					href={profileUrl(p.username)}
					target="_blank"
					rel="noopener"
					aria-label={`${p.name} on Letterboxd (opens in a new tab)`}
				>
					<span class="min-w-0 truncate">@{p.username}</span>
					<svg
						class="shrink-0"
						width="11"
						height="11"
						viewBox="0 0 12 12"
						fill="none"
						aria-hidden="true"
					>
						<path
							d="M4.25 2.25H2.5a.75.75 0 0 0-.75.75v6.5c0 .414.336.75.75.75H9a.75.75 0 0 0 .75-.75V7.75M6.25 1.75h4v4m0-4-5.5 5.5"
							stroke="currentColor"
							stroke-width="1.25"
							stroke-linecap="round"
							stroke-linejoin="round"
						></path>
					</svg>
				</a>
			</span>
		</span>
	</div>
</li>
