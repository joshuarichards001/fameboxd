---
import { hasTagIntro } from "../functions/tags";

// Site-wide nav, rendered by Base.astro so every page carries the same one.
// Four real links cover the directory, catalogue, rankings and daily feed.
// Compact phone spacing keeps them visible at 320px without a burger or JS.
const LINKS = [
	{ href: "/", label: "People" },
	{ href: "/films/", label: "Films" },
	{ href: "/rankings/", label: "Rankings" },
	{ href: "/recent/", label: "Recent" },
];

// Which link to mark current. Person pages and the tag pages (/directors/,
// /actors/, …) are the directory under a filter, so they light up "People";
// tag slugs are recognised by asking tags.ts rather than by pattern, so a
// one-segment URL that isn't a tag (404) lights up nothing.
const path = Astro.url.pathname;
const segment = path.replace(/^\/|\/$/g, "");
const current =
	path === "/recent/"
		? "/recent/"
		: path.startsWith("/rankings")
			? "/rankings/"
		: path.startsWith("/films")
			? "/films/"
			: path === "/" ||
				  path.startsWith("/people/") ||
				  hasTagIntro(segment.replace(/s$/, ""))
				? "/"
				: null;
---

<nav class="border-b border-border" aria-label="Main">
	<div class="wrap flex items-center justify-between gap-1 py-3 sm:gap-3">
		<a
			class="text-[0.85rem] font-extrabold uppercase tracking-[0.14em] text-text no-underline transition-colors duration-[120ms] hover:text-orange focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue motion-reduce:transition-none"
			href="/">Fameboxd</a
		>
		<ul class="m-0 flex list-none items-center gap-0 p-0 sm:gap-1">
			{
				LINKS.map((link) => (
					<li>
						<a
							class="block rounded-full px-1 py-1.5 text-[0.72rem] font-semibold text-text-dim no-underline transition-colors duration-[120ms] hover:bg-bg-raised hover:text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue aria-[current=page]:bg-bg-raised aria-[current=page]:text-orange motion-reduce:transition-none sm:px-3 sm:text-[0.85rem]"
							href={link.href}
							aria-current={link.href === current ? "page" : undefined}
						>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</nav>
