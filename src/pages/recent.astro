---
import Footer from "../components/Footer.astro";
import people from "../data/people.json";
import { activity, personPageUrl, posterUrl } from "../functions/activity";
import { hueFor, initials, loadAvatarSet } from "../functions/avatars";
import { celebrityNoun, filmPageUrl, hasFilmPage } from "../functions/films";
import { stars, timeAgo, type Person } from "../functions/people";
import { recentWatches } from "../functions/recent";
import {
	TRENDING_DAYS,
	TRENDING_MIN_WATCHERS,
	trendingFilms,
} from "../functions/trending";
import Base from "../layouts/Base.astro";

// The freshest URL on the site: it changes materially every day, so it earns
// frequent crawling, and every row is a door into a person page and a film
// page. 100 rows currently spans four or five days of watching.
const rows = recentWatches(activity, people as Person[], 100);
const avatars = loadAvatarSet();

// What the page leads with: the month's most-watched films, as posters. A film
// trending this month need not clear FILM_PAGE_MIN_WATCHERS all time, so the
// guard is load-bearing: it drops the ones with no page rather than publishing
// a link to a page nobody built.
const trending = trendingFilms(activity).filter((f) => hasFilmPage(f.slug));

// The films at the top change daily, which is the whole point of the line.
// Same 158-character budget as the person and film pages; a title that won't
// fit is skipped and the shorter ones behind it still make it in.
const newest = [...new Set(rows.map((r) => r.entry.title))];
const lead = `The ${rows.length} most recent films logged by celebrities on Letterboxd, newest first.`;
const line = (films: string[]) =>
	films.length > 0
		? `${lead} Just watched: ${films.join(", ")}. Updated daily.`
		: `${lead} Updated daily.`;
const chosen: string[] = [];
for (const film of newest.slice(0, 4)) {
	if (line([...chosen, film]).length <= 158) chosen.push(film);
}

const title = "Recently Watched by Celebrities on Letterboxd | Fameboxd";
const description = line(chosen);
---

<Base title={title} description={description}>
	<main class="wrap py-8">
		<a
			class="text-[0.9rem] font-semibold text-text-dim no-underline transition-colors duration-[120ms] hover:text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue motion-reduce:transition-none"
			href="/">&larr; All people</a
		>

		<header class="mt-6 flex flex-wrap items-end justify-between gap-4">
			<h1
				class="m-0 max-w-[20ch] text-[clamp(1.6rem,4.5vw,2.4rem)] font-extrabold leading-[1.1] tracking-[-0.02em]"
			>
				What celebrities are watching <span class="text-orange"
					>right now</span
				>
			</h1>
			<a
				class="inline-flex items-center gap-2 rounded-full bg-orange px-5 py-2 text-[0.95rem] font-bold text-bg no-underline transition-colors duration-[120ms] hover:bg-[color-mix(in_srgb,var(--color-orange)_80%,white)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue motion-reduce:transition-none"
				href="/feed.xml">Subscribe by RSS</a
			>
		</header>

		<p class="mt-4 max-w-[68ch] text-[0.95rem] leading-[1.6] text-text-dim">
			{description}
		</p>

		{
			trending.length > 0 && (
				<section class="mt-8" aria-labelledby="trending">
					<h2
						id="trending"
						class="m-0 text-[1.05rem] font-bold tracking-[-0.01em]"
					>
						Most watched this month
					</h2>
					<p class="mt-1 mb-0 text-[0.85rem] text-text-dim">
						The films at least {TRENDING_MIN_WATCHERS} of them logged in the
						last {TRENDING_DAYS} days.
					</p>
					{/* Two across on a phone rather than four: at four, a poster is
					    80px wide and the title under it wraps to three lines. */}
					<ul class="mt-4 grid max-w-[900px] grid-cols-2 gap-4 sm:grid-cols-4">
						{trending.map((film) => (
							<li>
								<a
									class="group block no-underline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-blue"
									href={filmPageUrl(film.slug)}
								>
									<div class="overflow-hidden rounded-card border border-border bg-bg-raised">
										{film.poster ? (
											<img
												class="block aspect-[2/3] w-full object-cover transition-transform duration-[160ms] group-hover:scale-[1.03] motion-reduce:transition-none"
												src={posterUrl(film.poster, 300)}
												srcset={`${posterUrl(film.poster, 300)} 300w, ${posterUrl(film.poster, 600)} 600w`}
												sizes="(min-width: 640px) 220px, 45vw"
												width="300"
												height="450"
												decoding="async"
												alt=""
											/>
										) : (
											/* A film logged before its poster was captured. The
											   title is already below, so this is the tile the
											   monogram avatars are: colored, not blank. */
											<span
												class="flex aspect-[2/3] w-full items-center justify-center p-3 text-center text-[0.85rem] font-bold text-[hsl(var(--hue)_55%_80%)] bg-[hsl(var(--hue)_32%_24%)]"
												aria-hidden="true"
												style={`--hue:${hueFor(film.title)}`}
											>
												{film.title}
											</span>
										)}
									</div>
									<p class="mt-2 mb-0 text-[0.85rem] font-semibold leading-[1.35] text-text transition-colors duration-[120ms] group-hover:text-orange motion-reduce:transition-none">
										{film.title}
										{film.year != null && (
											<span class="ml-1 font-normal text-text-faint tabular-nums">
												{film.year}
											</span>
										)}
									</p>
									{/* "this month", because a film page counts every watcher
									    it ever had — 30 here against 36 there reads as a
									    contradiction unless the window is on the label. */}
									<p class="mt-0.5 mb-0 text-[0.78rem] text-text-faint">
										{film.watchers} {celebrityNoun(film.watchers)} this month
									</p>
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}

		<div class="mt-8 overflow-x-auto">
			{/* Per-row styling hoisted onto the table: this page is rebuilt and
			    recrawled daily, so the same classes repeated across 100 rows are
			    bytes it pays for every time. */}
			<table
				class="w-full min-w-[560px] border-collapse text-left text-[0.9rem] [&_th]:py-2 [&_th]:pr-3 [&_td]:py-2 [&_td]:pr-3 [&_tbody_tr]:border-b [&_tbody_tr]:border-border/50 [&_tbody_th]:font-normal [&_a]:font-semibold [&_a]:text-text [&_a]:no-underline [&_a]:transition-colors [&_a]:duration-[120ms] [&_a:hover]:text-orange [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-offset-2 [&_a:focus-visible]:outline-blue motion-reduce:[&_a]:transition-none"
			>
				<caption class="mb-3 text-left text-[0.85rem] text-text-faint">
					The newest entries in the public Letterboxd diaries of the {
						people.length
					} celebrities in this directory, refreshed daily.
				</caption>
				<thead>
					<tr
						class="border-b border-border [&_th]:text-[0.72rem] [&_th]:font-bold [&_th]:uppercase [&_th]:tracking-[0.08em] [&_th]:text-text-faint"
					>
						<th scope="col">Person</th>
						<th scope="col">Watched</th>
						<th scope="col">Rating</th>
						<th scope="col">When</th>
					</tr>
				</thead>
				<tbody>
					{
						rows.map(({ person, entry }) => (
							<tr>
								<th scope="row">
									<span class="flex items-center gap-2">
										{avatars.has(person.username) ? (
											<img
												class="h-7 w-7 shrink-0 rounded-full border border-border bg-bg object-cover"
												src={`/avatars/${person.username}.webp`}
												width="28"
												height="28"
												loading="lazy"
												decoding="async"
												alt=""
											/>
										) : (
											<span
												class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border text-[0.62rem] font-bold text-[hsl(var(--hue)_55%_80%)] bg-[hsl(var(--hue)_32%_24%)] border-[hsl(var(--hue)_28%_34%)]"
												aria-hidden="true"
												style={`--hue:${hueFor(person.name)}`}
											>
												{initials(person.name)}
											</span>
										)}
										<a href={personPageUrl(person.username)}>{person.name}</a>
									</span>
								</th>
								<td>
									{/* Films under the page threshold have no URL to point at,
									    so the title renders as plain text rather than a link. */}
									{hasFilmPage(entry.slug) ? (
										<a href={filmPageUrl(entry.slug)}>{entry.title}</a>
									) : (
										<span class="font-semibold text-text">{entry.title}</span>
									)}
									{entry.year != null && (
										<span class="ml-1.5 text-text-faint tabular-nums">
											{entry.year}
										</span>
									)}
									{entry.rewatch && (
										<span class="ml-1.5 text-[0.8rem] text-text-faint">
											<span aria-hidden="true">&#8635;</span>
											<span class="sr-only">Rewatch</span>
										</span>
									)}
									{entry.liked && (
										<span class="ml-1.5 text-[0.8rem] text-orange">
											<span aria-hidden="true">&#9829;</span>
											<span class="sr-only">Liked</span>
										</span>
									)}
								</td>
								<td class="whitespace-nowrap">
									{entry.rating != null ? (
										<span
											class="text-green"
											role="img"
											aria-label={`Rated ${entry.rating} out of 5`}
										>
											{stars(entry.rating)}
										</span>
									) : (
										/* No rating reads as an empty cell. */
										<span class="text-text-faint" aria-hidden="true">
											&mdash;
										</span>
									)}
								</td>
								<td class="whitespace-nowrap text-text-faint">
									<time datetime={entry.watchedDate} title={entry.watchedDate}>
										{timeAgo(entry.watchedDate)}
									</time>
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>

		<p class="mt-6 mb-0 text-[0.9rem] text-text-dim">
			<a
				class="font-semibold text-orange underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
				href="/films/">Every film these celebrities have watched &rarr;</a
			>
		</p>
	</main>

	<Footer />
</Base>
