---
import FilmsIndexPage from "../../components/FilmsIndexPage.astro";
import {
    FILMS_PER_LISTING_PAGE,
    filmPages,
} from "../../functions/films";

// The crawl hub and first page of the paginated catalogue. Film detail pages
// remain in one ranked collection without forcing thousands of poster cards
// into a single response.
const allFilms = filmPages();
const totalPages = Math.ceil(allFilms.length / FILMS_PER_LISTING_PAGE);
---

<FilmsIndexPage
    films={allFilms.slice(0, FILMS_PER_LISTING_PAGE)}
    totalFilms={allFilms.length}
    page={1}
    totalPages={totalPages}
/>
